  "query": "SELECT v.version_id, v.record_id, r.type AS record_type, r.visibility\n         FROM versions v JOIN records r ON r.id = v.record_id\n         WHERE r.ns = $1 AND r.name = $2 AND v.seq = $3\n           AND ($4::text IS NULL OR r.type = $4)\n         ORDER BY r.type",
