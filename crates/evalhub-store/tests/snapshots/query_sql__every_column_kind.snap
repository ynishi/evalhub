---
source: crates/evalhub-store/tests/query_sql.rs
expression: render(&query)
---
SELECT r.id AS record_id, r.ns, r.name, r.visibility, v.version_id, v.seq, v.label, v.content_hash, v.created_at, v.changed, v.badges, v.body, v.title FROM records r JOIN versions v ON v.record_id = r.id WHERE r.type = $1 AND (r.visibility = 'public' OR r.ns = ANY($2)) AND v.tombstoned_at IS NULL AND v.seq = (SELECT max(seq) FROM versions v2 WHERE v2.record_id = v.record_id AND v2.tombstoned_at IS NULL) AND (v.model_id = $3 AND v.gen_temperature <= $4 AND EXISTS (SELECT 1 FROM fingerprints f WHERE f.version_id = v.version_id AND f.facet = $5 AND f.fingerprint = $6) AND evalhub_num(v.body #> '{"ext","alice/qwen-loop","rung"}') >= $7 AND v.body @> $8 AND v.task_split IS NOT NULL AND EXISTS (SELECT 1 FROM results x WHERE x.version_id = v.version_id AND x.metric = $9 AND x.value >= $10) AND EXISTS (SELECT 1 FROM relations x WHERE x.from_version_id = v.version_id AND (x.to_version_id IS NULL OR EXISTS (SELECT 1 FROM versions tv JOIN records tr ON tr.id = tv.record_id WHERE tv.version_id = x.to_version_id AND (tr.visibility = 'public' OR tr.ns = ANY($11)))) AND COALESCE(x.to_external, (SELECT r2.ns || '/' || r2.name || '@' || v2.seq FROM versions v2 JOIN records r2 ON r2.id = v2.record_id WHERE v2.version_id = x.to_version_id)) LIKE $12 ESCAPE '\') AND NOT (v.harness_name = ANY($13))) ORDER BY v.created_at DESC, v.version_id DESC LIMIT $14
