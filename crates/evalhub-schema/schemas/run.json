{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run",
  "description": "One run of an Eval: one execution, its conditions, its files and what\nwas measured directly from it. A run records what happened, never\nwhether it passed; the verdict is a Card's `run_results`.",
  "type": "object",
  "properties": {
    "artifacts": {
      "description": "This run's `attachments[].path` entries of artifacts the run produced.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "description": "Files this run refers to. `calls`, `artifacts[]` and `error.log` point here.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attachment"
      }
    },
    "calls": {
      "description": "This run's `attachments[].path` holding the model calls made during the run.",
      "type": [
        "string",
        "null"
      ]
    },
    "ended_at": {
      "description": "When the run ended.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "env": {
      "description": "The environment this run executed in. Filled from the Eval header when omitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/Env"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "description": "How the run failed. Present exactly when `status` is `error`.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunError"
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "description": "Producer-private extensions keyed by namespace.",
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "generation": {
      "description": "The sampling parameters of this run. Filled from the Eval header when omitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/Generation"
        },
        {
          "type": "null"
        }
      ]
    },
    "harness": {
      "description": "The harness that drove this run. Filled from the Eval header when omitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/Harness"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "description": "Free-form JSON kept with the run and returned verbatim. The hub never\nvalidates, indexes or queries it."
    },
    "metrics": {
      "description": "Values measured directly from the run, keyed by metric registry id\n`{ns}/{name}` (for example `core/tokens_out`). Grader-dependent\nvalues belong to a Card's `run_results`, not here.",
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      }
    },
    "model": {
      "description": "The model this run used. Filled from the Eval header when omitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/Model"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "description": "Run identifier, unique within the Eval record. One URL segment:\nnon-empty, no `/`, at most 200 bytes.",
      "type": "string"
    },
    "skip_reason": {
      "description": "Why the producer did not execute the run. Present exactly when\n`status` is `skipped`.",
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "description": "When the run started.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "description": "The state of the execution: `ok`, `error` or `skipped`.",
      "$ref": "#/$defs/RunStatus"
    },
    "task": {
      "description": "The task this run attempted. Filled from the Eval header when omitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/Task"
        },
        {
          "type": "null"
        }
      ]
    },
    "trial": {
      "description": "How this run's attempt was made. Filled from the Eval header when omitted.",
      "anyOf": [
        {
          "$ref": "#/$defs/Trial"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "run_id",
    "status"
  ],
  "$defs": {
    "Attachment": {
      "description": "A file in object storage that the record refers to by `path`.",
      "type": "object",
      "properties": {
        "media_type": {
          "description": "Media type of the file, for display and download only.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Relative, `..`-free name, unique within the record; other fields point at it.",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hex sha256 of the file's bytes; the object's address in storage.",
          "type": "string"
        },
        "size": {
          "description": "Size of the file in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ]
    },
    "Engine": {
      "description": "Inference engine name and version.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Engine name (`vllm`, `llama.cpp`, `transformers`, …).",
          "type": "string"
        },
        "version": {
          "description": "Engine version.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Env": {
      "description": "The software environment the evaluation ran in.",
      "type": "object",
      "properties": {
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "git": {
          "description": "Git state of the code that ran.",
          "anyOf": [
            {
              "$ref": "#/$defs/Git"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "description": "Hardware description. Recorded; does not affect the fingerprint.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hardware"
            },
            {
              "type": "null"
            }
          ],
          "x-fingerprint": false
        },
        "os": {
          "description": "Operating system description. Recorded; does not affect the fingerprint.",
          "type": [
            "string",
            "null"
          ],
          "x-fingerprint": false
        },
        "packages": {
          "description": "Pinned packages that matter to the result.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Package"
          }
        }
      },
      "additionalProperties": false
    },
    "Generation": {
      "description": "Sampling parameters.",
      "type": "object",
      "properties": {
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "max_tokens": {
          "description": "Maximum tokens generated per response.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "n": {
          "description": "Number of completions requested per prompt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "reasoning": {
          "description": "Reasoning (extended thinking) settings.",
          "anyOf": [
            {
              "$ref": "#/$defs/Reasoning"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "description": "Sampling seed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "stop": {
          "description": "Stop sequences.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature": {
          "description": "Sampling temperature.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "top_k": {
          "description": "Top-k sampling cutoff.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "top_p": {
          "description": "Nucleus sampling threshold.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Git": {
      "description": "Git state of the evaluating code.",
      "type": "object",
      "properties": {
        "commit": {
          "description": "Commit that ran.",
          "type": "string"
        },
        "dirty": {
          "description": "Whether the working tree had uncommitted changes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "origin": {
          "description": "Remote the code came from.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "commit"
      ]
    },
    "Hardware": {
      "description": "Hardware the evaluation ran on.",
      "type": "object",
      "properties": {
        "cpu": {
          "description": "CPU model.",
          "type": [
            "string",
            "null"
          ]
        },
        "gpu": {
          "description": "Accelerator model (for example `A100`).",
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_count": {
          "description": "Number of accelerators.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "memory_gb": {
          "description": "Memory in gigabytes.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Harness": {
      "description": "The harness that drove the evaluation.",
      "type": "object",
      "properties": {
        "config_sha256": {
          "description": "sha256 of the harness configuration that was in effect.",
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "few_shot": {
          "description": "Number of few-shot examples in the prompt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Harness name.",
          "type": "string"
        },
        "prompt_template_sha256": {
          "description": "sha256 of the prompt template.",
          "type": [
            "string",
            "null"
          ]
        },
        "system_prompt_sha256": {
          "description": "sha256 of the system prompt.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Harness version.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "Model": {
      "description": "The model that was evaluated.",
      "type": "object",
      "properties": {
        "availability": {
          "description": "Availability of the weights (`open`, `api`, `private`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "context_window": {
          "description": "Context window in tokens. Recorded; does not affect the fingerprint.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "x-fingerprint": false
        },
        "endpoint": {
          "description": "Endpoint the model was reached through, when that changes the result.",
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "description": "Inference engine that ran the model.",
          "anyOf": [
            {
              "$ref": "#/$defs/Engine"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Model identifier as the producer names it (for example `qwen3.6-32b`).",
          "type": "string"
        },
        "provider": {
          "description": "Who served the model (`openai`, `anthropic`, `local`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "quantization": {
          "description": "Quantisation applied to the weights.",
          "anyOf": [
            {
              "$ref": "#/$defs/Quantization"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "description": "Exact revision: a commit, a checkpoint tag, or a provider snapshot date.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Package": {
      "description": "A pinned package.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Package name.",
          "type": "string"
        },
        "version": {
          "description": "Package version.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "Quantization": {
      "description": "Weight quantisation.",
      "type": "object",
      "properties": {
        "dtype": {
          "description": "Storage type (`int4`, `int8`, `fp8`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "description": "Method (`awq`, `gptq`, `gguf`, …).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "method"
      ]
    },
    "Reasoning": {
      "description": "Reasoning settings passed to the model.",
      "type": "object",
      "properties": {
        "budget_tokens": {
          "description": "Token budget for reasoning.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "effort": {
          "description": "Provider-defined effort level (`low`, `medium`, `high`, …).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RunError": {
      "description": "How a run failed.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Short slug naming the kind of failure, `[a-z0-9][a-z0-9._-]*`\n(for example `timeout`, `budget_exhausted`, `crash`). Chosen by the\nproducer; not a closed list. `unrecorded` means the kind is not known.",
          "type": "string"
        },
        "log": {
          "description": "This run's `attachments[].path` holding the failure's log (stderr, a trace).",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "What went wrong, for a human.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "RunStatus": {
      "description": "The state of a run's execution. Not a verdict: pass and fail are a Card's.",
      "oneOf": [
        {
          "description": "The run went to completion.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "The run was executed and failed along the way; `error` says how.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "The producer deliberately did not execute the run; `skip_reason` says why.",
          "type": "string",
          "const": "skipped"
        }
      ]
    },
    "Sandbox": {
      "description": "Container image the attempts ran in.",
      "type": "object",
      "properties": {
        "digest": {
          "description": "Content digest of the image (`sha256:…`).",
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "description": "Image reference (for example `ghcr.io/org/image:tag`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "image"
      ]
    },
    "Task": {
      "description": "The task or benchmark that was run.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Named task configuration, when the task has more than one.",
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Task identifier as the producer names it (for example `single2`).",
          "type": "string"
        },
        "n": {
          "description": "Number of items evaluated.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "revision": {
          "description": "Exact revision of the task material (a commit or dataset revision).",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_ids_sha256": {
          "description": "sha256 over the sorted list of sample ids that were evaluated.",
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "description": "Seed used to select or order items.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "shuffled": {
          "description": "Whether items were shuffled before evaluation.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_data": {
          "description": "Where the task data came from (a URL or dataset id).",
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "description": "Split that was evaluated (`test`, `validation`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Task version, as published by the task's author.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Trial": {
      "description": "How each item was attempted.",
      "type": "object",
      "properties": {
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "k": {
          "description": "Attempts per item.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_turns": {
          "description": "Maximum agent turns per attempt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "pass_at_k": {
          "description": "Whether the score is pass@k over the attempts.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "retries": {
          "description": "Retries on error per attempt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "sandbox": {
          "description": "Sandbox the attempt ran in.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sandbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "description": "Timeout per attempt in milliseconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
