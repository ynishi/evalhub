{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Card",
  "description": "A Card: what was measured, how, and what the score was.",
  "type": "object",
  "properties": {
    "attachments": {
      "description": "Files this record refers to.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attachment"
      }
    },
    "counts": {
      "description": "Item counts the scores were computed over. Required when `results` is non-empty.",
      "anyOf": [
        {
          "$ref": "#/$defs/Counts"
        },
        {
          "type": "null"
        }
      ]
    },
    "env": {
      "description": "The environment facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Env"
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "description": "Producer-private extensions keyed by namespace.",
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "generation": {
      "description": "The generation facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Generation"
        },
        {
          "type": "null"
        }
      ]
    },
    "grading": {
      "description": "The grading facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Grading"
        },
        {
          "type": "null"
        }
      ]
    },
    "harness": {
      "description": "The harness facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Harness"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "description": "The model facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Model"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer": {
      "description": "The software that wrote this record.",
      "$ref": "#/$defs/Producer"
    },
    "provenance": {
      "description": "Where the numbers came from and who ran the evaluation.",
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "redaction": {
      "description": "What the producer removed before publishing.",
      "anyOf": [
        {
          "$ref": "#/$defs/Redaction"
        },
        {
          "type": "null"
        }
      ]
    },
    "relations": {
      "description": "Edges to other records.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relation"
      }
    },
    "results": {
      "description": "The scores.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResultEntry"
      }
    },
    "schema": {
      "description": "Schema identifier; must be `evalhub.card/1.0`.",
      "type": "string",
      "const": "evalhub.card/1.0"
    },
    "task": {
      "description": "The task facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Task"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "description": "Human-readable title.",
      "type": "string"
    },
    "trial": {
      "description": "The trial facet.",
      "anyOf": [
        {
          "$ref": "#/$defs/Trial"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "producer"
  ],
  "$defs": {
    "Aggregation": {
      "description": "How a score was derived from its samples.",
      "oneOf": [
        {
          "description": "Arithmetic mean over samples.",
          "type": "string",
          "const": "mean"
        },
        {
          "description": "pass@k over attempts.",
          "type": "string",
          "const": "pass_at_k"
        },
        {
          "description": "Median over samples.",
          "type": "string",
          "const": "median"
        },
        {
          "description": "Sum over samples.",
          "type": "string",
          "const": "sum"
        },
        {
          "description": "A producer-defined aggregation; describe it in `ext`.",
          "type": "string",
          "const": "custom"
        }
      ]
    },
    "Attachment": {
      "description": "A file in object storage that the record refers to by `path`.",
      "type": "object",
      "properties": {
        "media_type": {
          "description": "Media type of the file, for display and download only.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Relative, `..`-free name, unique within the record; other fields point at it.",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hex sha256 of the file's bytes; the object's address in storage.",
          "type": "string"
        },
        "size": {
          "description": "Size of the file in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ]
    },
    "ConfidenceInterval": {
      "description": "A confidence interval.",
      "type": "object",
      "properties": {
        "high": {
          "description": "Upper bound.",
          "type": "number",
          "format": "double"
        },
        "level": {
          "description": "Confidence level, for example `0.95`.",
          "type": "number",
          "format": "double"
        },
        "low": {
          "description": "Lower bound.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "low",
        "high"
      ]
    },
    "Counts": {
      "description": "Item counts. `attempted >= completed + failed + skipped + errored`.",
      "type": "object",
      "properties": {
        "attempted": {
          "description": "Items the evaluation set out to run.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "completed": {
          "description": "Items that produced a gradable response.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "errored": {
          "description": "Items that errored before grading.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "failed": {
          "description": "Items that were graded as failing.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "skipped": {
          "description": "Items skipped by the harness.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "attempted"
      ]
    },
    "Engine": {
      "description": "Inference engine name and version.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Engine name (`vllm`, `llama.cpp`, `transformers`, …).",
          "type": "string"
        },
        "version": {
          "description": "Engine version.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Env": {
      "description": "The software environment the evaluation ran in.",
      "type": "object",
      "properties": {
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "git": {
          "description": "Git state of the code that ran.",
          "anyOf": [
            {
              "$ref": "#/$defs/Git"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "description": "Hardware description. Recorded; does not affect the fingerprint.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hardware"
            },
            {
              "type": "null"
            }
          ],
          "x-fingerprint": false
        },
        "os": {
          "description": "Operating system description. Recorded; does not affect the fingerprint.",
          "type": [
            "string",
            "null"
          ],
          "x-fingerprint": false
        },
        "packages": {
          "description": "Pinned packages that matter to the result.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Package"
          }
        }
      },
      "additionalProperties": false
    },
    "EvaluatorRelationship": {
      "description": "Who ran the evaluation relative to the model's maker.",
      "oneOf": [
        {
          "description": "The model's maker evaluated its own model.",
          "type": "string",
          "const": "first_party"
        },
        {
          "description": "Someone else evaluated it.",
          "type": "string",
          "const": "third_party"
        }
      ]
    },
    "Generation": {
      "description": "Sampling parameters.",
      "type": "object",
      "properties": {
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "max_tokens": {
          "description": "Maximum tokens generated per response.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "n": {
          "description": "Number of completions requested per prompt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "reasoning": {
          "description": "Reasoning (extended thinking) settings.",
          "anyOf": [
            {
              "$ref": "#/$defs/Reasoning"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "description": "Sampling seed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "stop": {
          "description": "Stop sequences.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temperature": {
          "description": "Sampling temperature.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "top_k": {
          "description": "Top-k sampling cutoff.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "top_p": {
          "description": "Nucleus sampling threshold.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Git": {
      "description": "Git state of the evaluating code.",
      "type": "object",
      "properties": {
        "commit": {
          "description": "Commit that ran.",
          "type": "string"
        },
        "dirty": {
          "description": "Whether the working tree had uncommitted changes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "origin": {
          "description": "Remote the code came from.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "commit"
      ]
    },
    "Grader": {
      "description": "One grader.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Grader kind (`deterministic`, `model`, `human`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Grader name (`exact_match`, `llm_judge`, …).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Grading": {
      "description": "How responses were scored. Cards only.",
      "type": "object",
      "properties": {
        "aggregation": {
          "description": "How several graders' verdicts were combined (`majority`, `all`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "graders": {
          "description": "Graders that produced the scores.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Grader"
          }
        },
        "judge": {
          "description": "Judge model, when a grader is a model.",
          "anyOf": [
            {
              "$ref": "#/$defs/Judge"
            },
            {
              "type": "null"
            }
          ]
        },
        "rubric_sha256": {
          "description": "sha256 of the rubric given to the graders.",
          "type": [
            "string",
            "null"
          ]
        },
        "threshold": {
          "description": "Threshold a score had to reach to count as a pass.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Hardware": {
      "description": "Hardware the evaluation ran on.",
      "type": "object",
      "properties": {
        "cpu": {
          "description": "CPU model.",
          "type": [
            "string",
            "null"
          ]
        },
        "gpu": {
          "description": "Accelerator model (for example `A100`).",
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_count": {
          "description": "Number of accelerators.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "memory_gb": {
          "description": "Memory in gigabytes.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Harness": {
      "description": "The harness that drove the evaluation.",
      "type": "object",
      "properties": {
        "config_sha256": {
          "description": "sha256 of the harness configuration that was in effect.",
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "few_shot": {
          "description": "Number of few-shot examples in the prompt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Harness name.",
          "type": "string"
        },
        "prompt_template_sha256": {
          "description": "sha256 of the prompt template.",
          "type": [
            "string",
            "null"
          ]
        },
        "system_prompt_sha256": {
          "description": "sha256 of the system prompt.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Harness version.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "Judge": {
      "description": "The judge model used by a model grader.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Judge model identifier.",
          "type": "string"
        },
        "provider": {
          "description": "Who served the judge.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Exact revision of the judge.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Model": {
      "description": "The model that was evaluated.",
      "type": "object",
      "properties": {
        "availability": {
          "description": "Availability of the weights (`open`, `api`, `private`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "context_window": {
          "description": "Context window in tokens. Recorded; does not affect the fingerprint.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "x-fingerprint": false
        },
        "endpoint": {
          "description": "Endpoint the model was reached through, when that changes the result.",
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "description": "Inference engine that ran the model.",
          "anyOf": [
            {
              "$ref": "#/$defs/Engine"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Model identifier as the producer names it (for example `qwen3.6-32b`).",
          "type": "string"
        },
        "provider": {
          "description": "Who served the model (`openai`, `anthropic`, `local`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "quantization": {
          "description": "Quantisation applied to the weights.",
          "anyOf": [
            {
              "$ref": "#/$defs/Quantization"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "description": "Exact revision: a commit, a checkpoint tag, or a provider snapshot date.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Package": {
      "description": "A pinned package.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Package name.",
          "type": "string"
        },
        "version": {
          "description": "Package version.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "Producer": {
      "description": "The software that wrote the record. Informational; not a facet.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the producing software (a harness, a converter, a script).",
          "type": "string"
        },
        "version": {
          "description": "Version of the producing software.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "Provenance": {
      "description": "Where the numbers came from.",
      "type": "object",
      "properties": {
        "evaluator_relationship": {
          "description": "Who ran the evaluation relative to the model's maker.",
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluatorRelationship"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_type": {
          "description": "What kind of source the numbers were taken from.",
          "$ref": "#/$defs/SourceType"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_type"
      ]
    },
    "Quantization": {
      "description": "Weight quantisation.",
      "type": "object",
      "properties": {
        "dtype": {
          "description": "Storage type (`int4`, `int8`, `fp8`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "description": "Method (`awq`, `gptq`, `gguf`, …).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "method"
      ]
    },
    "Reasoning": {
      "description": "Reasoning settings passed to the model.",
      "type": "object",
      "properties": {
        "budget_tokens": {
          "description": "Token budget for reasoning.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "effort": {
          "description": "Provider-defined effort level (`low`, `medium`, `high`, …).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Redaction": {
      "description": "The producer's statement about what it removed before publishing.",
      "type": "object",
      "properties": {
        "applied": {
          "description": "Whether any redaction was applied.",
          "type": "boolean"
        },
        "fields": {
          "description": "Which fields were redacted, as `attachment path:field` or a record path.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "description": "How it was applied (for example `regex+llm`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "applied"
      ]
    },
    "Relation": {
      "description": "An edge from this version to another record version or an external target.",
      "type": "object",
      "properties": {
        "attrs": {
          "description": "Attributes specific to the relation type (for `uses_eval`, which runs were used).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "to": {
          "description": "Target: `{ns}/{name}@{seq}` on the hub, or `external:<url>` / `hf:<org>/<repo>@<sha>` outside it.",
          "type": "string"
        },
        "type": {
          "description": "Relation type as a registry id, `{ns}/{name}` (for example `core/uses_eval`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "to"
      ]
    },
    "ResultEntry": {
      "description": "One score.",
      "type": "object",
      "properties": {
        "aggregation": {
          "description": "How `value` was derived from the samples.",
          "$ref": "#/$defs/Aggregation"
        },
        "by": {
          "description": "The partition this score applies to (for example which grader).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "metric": {
          "description": "Metric as a registry id, `{ns}/{name}` (for example `core/pass_rate`).",
          "type": "string"
        },
        "n": {
          "description": "Number of samples the score was computed over.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "samples_ref": {
          "description": "`attachments[].path` of the per-sample rows this score summarises.",
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "description": "Uncertainty the producer computed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "description": "The score.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "aggregation"
      ]
    },
    "Sandbox": {
      "description": "Container image the attempts ran in.",
      "type": "object",
      "properties": {
        "digest": {
          "description": "Content digest of the image (`sha256:…`).",
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "description": "Image reference (for example `ghcr.io/org/image:tag`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "image"
      ]
    },
    "SourceType": {
      "description": "The kind of source a Card's numbers were taken from.",
      "oneOf": [
        {
          "description": "The producer ran the evaluation and recorded the result.",
          "type": "string",
          "const": "evaluation_run"
        },
        {
          "description": "Transcribed from a paper.",
          "type": "string",
          "const": "paper"
        },
        {
          "description": "Transcribed from a model card.",
          "type": "string",
          "const": "model_card"
        },
        {
          "description": "Transcribed from a leaderboard.",
          "type": "string",
          "const": "leaderboard"
        },
        {
          "description": "Something else; describe it in `ext`.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "Task": {
      "description": "The task or benchmark that was run.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Named task configuration, when the task has more than one.",
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "description": "Task identifier as the producer names it (for example `single2`).",
          "type": "string"
        },
        "n": {
          "description": "Number of items evaluated.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "revision": {
          "description": "Exact revision of the task material (a commit or dataset revision).",
          "type": [
            "string",
            "null"
          ]
        },
        "sample_ids_sha256": {
          "description": "sha256 over the sorted list of sample ids that were evaluated.",
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "description": "Seed used to select or order items.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "shuffled": {
          "description": "Whether items were shuffled before evaluation.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_data": {
          "description": "Where the task data came from (a URL or dataset id).",
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "description": "Split that was evaluated (`test`, `validation`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Task version, as published by the task's author.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Trial": {
      "description": "How each item was attempted.",
      "type": "object",
      "properties": {
        "ext": {
          "description": "Extensions keyed by namespace; not fingerprinted unless registered.",
          "type": "object",
          "additionalProperties": true
        },
        "k": {
          "description": "Attempts per item.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_turns": {
          "description": "Maximum agent turns per attempt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "pass_at_k": {
          "description": "Whether the score is pass@k over the attempts.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "retries": {
          "description": "Retries on error per attempt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "sandbox": {
          "description": "Sandbox the attempt ran in.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sandbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "description": "Timeout per attempt in milliseconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Uncertainty": {
      "description": "Uncertainty of a score.",
      "type": "object",
      "properties": {
        "ci": {
          "description": "Confidence interval of the score.",
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "description": "Standard error of the score.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    }
  }
}
