---
source: crates/evalhub-server/tests/boot.rs
expression: body
---
{
  "components": {
    "schemas": {
      "AnnounceBody": {
        "additionalProperties": false,
        "description": "Body of `POST /attachments`.",
        "properties": {
          "media_type": {
            "description": "Media type hint, for display and download. Not interpreted.",
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "description": "sha256 of the bytes, 64 lower-case hexadecimal characters. This is\nthe object's only name.",
            "type": "string"
          },
          "size": {
            "description": "Size of the bytes. `complete` refuses an object of another size.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "type": "object"
      },
      "AuditEntry": {
        "description": "One entry of the log.",
        "properties": {
          "action": {
            "description": "What happened, such as `version.append` or `org.member.add`.",
            "type": "string"
          },
          "actor": {
            "description": "Login of the user behind the action, if there was one.",
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "description": "When it happened.",
            "format": "date-time",
            "type": "string"
          },
          "detail": {
            "description": "Action-specific facts."
          },
          "ns": {
            "description": "The namespace the action concerns.",
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "description": "What it happened to, such as `card/alice/single2@3`.",
            "type": [
              "string",
              "null"
            ]
          },
          "token_id": {
            "description": "Identifier of the token presented, if one was.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "at",
          "action"
        ],
        "type": "object"
      },
      "AuditQuery": {
        "description": "Query string of `GET /audit`.",
        "properties": {
          "cursor": {
            "description": "Cursor from a previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "description": "Page size, 1–200; default 50.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ns": {
            "description": "Namespace to read the log of. The caller needs `admin` on it.",
            "type": "string"
          }
        },
        "required": [
          "ns"
        ],
        "type": "object"
      },
      "ComparisonDto": {
        "description": "The comparison view: Cards measured on one Eval version.",
        "properties": {
          "groups": {
            "description": "The Cards grouped by the requested facet fingerprint.",
            "items": {
              "$ref": "#/components/schemas/ComparisonGroupDto"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "items": {
            "description": "Every Card, when `group_by` was not given.",
            "items": {
              "$ref": "#/components/schemas/ComparisonRowDto"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ComparisonGroupDto": {
        "description": "Cards sharing one fingerprint of the facet named in `group_by`.",
        "properties": {
          "items": {
            "description": "The Cards in the group.",
            "items": {
              "$ref": "#/components/schemas/ComparisonRowDto"
            },
            "type": "array"
          },
          "key": {
            "description": "The shared fingerprint in hex, or `null` for Cards with none.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ComparisonQuery": {
        "description": "Query string of the comparison view.",
        "properties": {
          "group_by": {
            "description": "`fingerprint.{facet}` for one of the seven facets. Groups the\nCards by that fingerprint; omitted, the list is flat.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ComparisonRowDto": {
        "description": "One Card in the comparison view.",
        "properties": {
          "content_hash": {
            "description": "sha256 of the canonical body.",
            "type": "string"
          },
          "fingerprints": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-facet fingerprints, hex, keyed by facet name.",
            "type": "object"
          },
          "name": {
            "description": "Record name.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace.",
            "type": "string"
          },
          "same_harness": {
            "description": "The Card's harness fingerprint equals the Eval's.",
            "type": "boolean"
          },
          "same_model": {
            "description": "The Card's model fingerprint equals the Eval's.",
            "type": "boolean"
          },
          "seq": {
            "description": "Sequence number of that version.",
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "The record's title.",
            "type": [
              "string",
              "null"
            ]
          },
          "version_id": {
            "description": "The Card's latest live version.",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "ns",
          "name",
          "seq",
          "content_hash",
          "fingerprints",
          "same_harness",
          "same_model"
        ],
        "type": "object"
      },
      "CompletedDto": {
        "description": "Response of `POST /attachments/{sha256}/complete`.",
        "properties": {
          "hashed_by_hub": {
            "description": "Whether the hub re-hashed the bytes. `false` means the object was\nabove `attachments.hash_verify_max_bytes` and the client's sha256\nwas taken on trust; the record says which.",
            "type": "boolean"
          },
          "size": {
            "description": "Size of the object as the store reports it.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "size",
          "hashed_by_hub"
        ],
        "type": "object"
      },
      "Dir": {
        "description": "Sort direction.",
        "oneOf": [
          {
            "const": "asc",
            "description": "Ascending.",
            "type": "string"
          },
          {
            "const": "desc",
            "description": "Descending.",
            "type": "string"
          }
        ]
      },
      "DirectionParam": {
        "description": "Which edges a traversal follows.",
        "oneOf": [
          {
            "const": "out",
            "description": "Edges leaving the node.",
            "type": "string"
          },
          {
            "const": "in",
            "description": "Edges entering the node.",
            "type": "string"
          },
          {
            "const": "both",
            "description": "Both.",
            "type": "string"
          }
        ]
      },
      "EdgeDto": {
        "description": "An edge of the relation graph.",
        "properties": {
          "attrs": {
            "description": "Free-form attributes."
          },
          "from": {
            "description": "Version the edge leaves.",
            "type": "string"
          },
          "to": {
            "description": "Version it points at, when the target is on this hub.",
            "type": [
              "string",
              "null"
            ]
          },
          "to_text": {
            "description": "Textual target, for an unresolved or external reference.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "Registry id of the relation type.",
            "type": "string"
          }
        },
        "required": [
          "from",
          "type"
        ],
        "type": "object"
      },
      "EntryDto": {
        "description": "One registry entry.",
        "properties": {
          "body": {
            "description": "The definition, whose shape depends on the kind."
          },
          "created_at": {
            "description": "When it was registered.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Identifier within the namespace.",
            "type": "string"
          },
          "kind": {
            "description": "`metrics`, `harnesses`, `relation_types` or `ext_schemas`.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace that owns it.",
            "type": "string"
          },
          "state": {
            "description": "`applied`, or `applying` while its indexes are being built.",
            "type": "string"
          },
          "version": {
            "description": "Version of the entry. Entries are immutable; a change is a new one.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ns",
          "id",
          "version",
          "body",
          "state",
          "created_at"
        ],
        "type": "object"
      },
      "EntryPage": {
        "description": "A page of entries. The registry is small, so this pages by offset\nrather than by cursor.",
        "properties": {
          "items": {
            "description": "The entries, ordered by kind, namespace, id and version.",
            "items": {
              "$ref": "#/components/schemas/EntryDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "EntryPath": {
        "description": "Path of one entry: `/registry/{kind}/{ns}/{id}` where `id` carries\n`@{version}`.",
        "properties": {
          "id": {
            "description": "Identifier followed by `@{version}`.",
            "type": "string"
          },
          "kind": {
            "description": "`metrics`, `harnesses`, `relation_types` or `ext_schemas`.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace that owns the entry.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ns",
          "id"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The closed set of error codes.",
        "oneOf": [
          {
            "const": "schema",
            "description": "JSON Schema violation: unknown key, wrong type, missing required key.",
            "type": "string"
          },
          {
            "const": "number_too_large",
            "description": "An integer outside ±2^53.",
            "type": "string"
          },
          {
            "const": "counts_missing",
            "description": "`results` is non-empty but `counts` is absent.",
            "type": "string"
          },
          {
            "const": "counts_inconsistent",
            "description": "`counts.attempted < completed + failed + skipped + errored`.",
            "type": "string"
          },
          {
            "const": "attachment_ref_unknown",
            "description": "A `samples_ref`, `calls`, `artifacts[]` or `error.log` entry names no `attachments[].path`.",
            "type": "string"
          },
          {
            "const": "attachment_path_invalid",
            "description": "An `attachments[].path` is duplicated, absolute, or contains `..`.",
            "type": "string"
          },
          {
            "const": "metric_id_invalid",
            "description": "A `results[].metric`, a `run_results[].metric` or a key of a run's\n`metrics` is not of the form `{ns}/{name}`.",
            "type": "string"
          },
          {
            "const": "type_mismatch",
            "description": "Query: operator applied to a path of another type.",
            "type": "string"
          },
          {
            "const": "not_indexed",
            "description": "Query: operator needs an index the path does not have.",
            "type": "string"
          },
          {
            "const": "unknown_path",
            "description": "Query: path not in the schema.",
            "type": "string"
          },
          {
            "const": "attachment_missing",
            "description": "An `attachments[].sha256` has not been uploaded and confirmed.",
            "type": "string"
          },
          {
            "const": "label_in_use",
            "description": "The requested `@{label}` already names another version.",
            "type": "string"
          },
          {
            "const": "namespace_in_use",
            "description": "The requested organisation slug is already a user or an organisation.",
            "type": "string"
          },
          {
            "const": "registry_entry_exists",
            "description": "A registry entry already exists at that address. Entries are\nimmutable, so a correction is a new version.",
            "type": "string"
          },
          {
            "const": "runs_moved",
            "description": "An `evalhub.eval/2.0` Eval header carries `runs`. Runs are not part\nof the header; they are written one by one or in a batch.",
            "type": "string"
          },
          {
            "const": "run_status_detail",
            "description": "A run's `status` and its detail disagree: `error` must be present\nexactly when `status` is `error`, `skip_reason` exactly when it is\n`skipped`.",
            "type": "string"
          },
          {
            "const": "run_id_invalid",
            "description": "A `run_id` is empty, contains `/`, or is longer than 200 bytes.",
            "type": "string"
          },
          {
            "const": "run_id_mismatch",
            "description": "The `run_id` in the body differs from the one in the request path.",
            "type": "string"
          },
          {
            "const": "run_result_value_or_label",
            "description": "A `run_results[]` element has neither `value` nor `label`.",
            "type": "string"
          },
          {
            "const": "run_results_eval_unknown",
            "description": "A `run_results[].eval` is not the record of any of the Card's\n`core/uses_eval` relations.",
            "type": "string"
          },
          {
            "const": "run_unknown",
            "description": "A `run_id` in the Card's used set has no row in that Eval (or the\nEval is one the writer may not see).",
            "type": "string"
          },
          {
            "const": "run_not_in_used_set",
            "description": "A `run_results[].run_id` is outside the Card's used set for its `eval`.",
            "type": "string"
          },
          {
            "const": "too_many_run_results",
            "description": "A Card version carries more `run_results[]` than the hub's configured limit.",
            "type": "string"
          },
          {
            "const": "run_deleted",
            "description": "The `run_id` names a run that was deleted. A deleted run's id is not\nreused, because Cards that judged it would then point at different content.",
            "type": "string"
          },
          {
            "const": "batch_duplicate_run_id",
            "description": "The same `run_id` appears more than once in one batch.",
            "type": "string"
          },
          {
            "const": "batch_too_large",
            "description": "A batch carries more runs than the hub's configured count.",
            "type": "string"
          },
          {
            "const": "body_too_large",
            "description": "The request body is larger than the hub's configured size in bytes.",
            "type": "string"
          }
        ]
      },
      "ErrorEntry": {
        "additionalProperties": false,
        "description": "One rejection.",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ],
            "description": "The code."
          },
          "hint": {
            "description": "Prose for a human. Not part of the contract.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Location in the submitted document, JSON-pointer-like (`results[0].metric`).",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "description": "The body of every `422` and `409` response.",
        "properties": {
          "errors": {
            "description": "Every rejection found, in document order.",
            "items": {
              "$ref": "#/components/schemas/ErrorEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "Expand": {
        "description": "Optional parts of a version that a read can include.",
        "oneOf": [
          {
            "const": "relations",
            "description": "The version's edges.",
            "type": "string"
          },
          {
            "const": "badges",
            "description": "The version's badges.",
            "type": "string"
          },
          {
            "const": "fingerprints",
            "description": "The seven facet fingerprints.",
            "type": "string"
          },
          {
            "const": "changed",
            "description": "The top-level keys that changed from the previous version.",
            "type": "string"
          }
        ]
      },
      "ExportQuery": {
        "description": "Query string of the export endpoints.",
        "properties": {
          "format": {
            "description": "`hf-model-index` or `bundle`.",
            "type": "string"
          }
        },
        "required": [
          "format"
        ],
        "type": "object"
      },
      "GetQuery": {
        "description": "Query string of `GET …/{name}`.",
        "properties": {
          "expand": {
            "description": "Comma-separated: `fingerprints`, `badges`, `changed`, `relations`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "GraphDto": {
        "description": "What a traversal found.",
        "properties": {
          "edges": {
            "description": "Every edge followed.",
            "items": {
              "$ref": "#/components/schemas/EdgeDto"
            },
            "type": "array"
          },
          "nodes": {
            "description": "Every version reached, the start first.",
            "items": {
              "$ref": "#/components/schemas/NodeDto"
            },
            "type": "array"
          }
        },
        "required": [
          "nodes",
          "edges"
        ],
        "type": "object"
      },
      "Health": {
        "description": "`GET /api/v1/healthz`",
        "properties": {
          "database": {
            "description": "`connected` when a database pool is open, `not_configured` otherwise.",
            "type": "string"
          },
          "status": {
            "description": "Always `ok` when the process answers.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "type": "object"
      },
      "Items_for_MemberDto": {
        "description": "A list of things, without paging: these are all small.\n\nThe schema name carries the item type, so a generated client gets one\nlist type per item type instead of `Items` and `Items2`.",
        "properties": {
          "items": {
            "description": "The items.",
            "items": {
              "$ref": "#/components/schemas/MemberDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Items_for_TokenDto": {
        "description": "A list of things, without paging: these are all small.\n\nThe schema name carries the item type, so a generated client gets one\nlist type per item type instead of `Items` and `Items2`.",
        "properties": {
          "items": {
            "description": "The items.",
            "items": {
              "$ref": "#/components/schemas/TokenDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "KindPath": {
        "description": "Path of `GET /registry/{kind}`.",
        "properties": {
          "kind": {
            "description": "`metrics`, `harnesses`, `relation_types` or `ext_schemas`.",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "LabelBody": {
        "description": "Body of `PATCH …/{name}@{seq}/label`.",
        "properties": {
          "label": {
            "description": "The label to point at this version. Moved if it named another.",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "ListItem": {
        "description": "One row of `GET /{cards|evals}`.",
        "properties": {
          "created_at": {
            "description": "When the name was created.",
            "format": "date-time",
            "type": "string"
          },
          "latest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VersionEnvelope"
              }
            ],
            "description": "The latest live version, without its record."
          },
          "name": {
            "description": "Name of the record.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace of the record.",
            "type": "string"
          },
          "title": {
            "description": "`title` of the latest live version.",
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VisibilityParam"
              }
            ],
            "description": "`public` or `private`."
          }
        },
        "required": [
          "ns",
          "name",
          "visibility",
          "created_at",
          "latest"
        ],
        "type": "object"
      },
      "ListQuery": {
        "description": "Query string of `GET /{cards|evals}`.",
        "properties": {
          "cursor": {
            "description": "Cursor from a previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "description": "Page size, 1–200; default 50.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ns": {
            "description": "Only records in this namespace.",
            "type": [
              "string",
              "null"
            ]
          },
          "search": {
            "description": "Case-insensitive substring of the name or the latest title.",
            "type": [
              "string",
              "null"
            ]
          },
          "sort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SortParam"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sort order; default `created_desc`."
          }
        },
        "type": "object"
      },
      "MemberDto": {
        "description": "A member of an organisation.",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "Their role in the organisation."
          },
          "user": {
            "description": "The member's login.",
            "type": "string"
          }
        },
        "required": [
          "user",
          "role"
        ],
        "type": "object"
      },
      "NamespaceDto": {
        "description": "A namespace and what it holds.",
        "properties": {
          "cards": {
            "description": "Cards in it that the caller may see.",
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "description": "When it was created.",
            "format": "date-time",
            "type": "string"
          },
          "evals": {
            "description": "Evals in it that the caller may see.",
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "description": "`user` or `org`.",
            "type": "string"
          },
          "ns": {
            "description": "The namespace: a user login or an organisation slug.",
            "type": "string"
          }
        },
        "required": [
          "ns",
          "kind",
          "created_at",
          "cards",
          "evals"
        ],
        "type": "object"
      },
      "NewMemberBody": {
        "additionalProperties": false,
        "description": "Body of `POST /orgs/{org}/members`.",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "The role they get."
          },
          "user": {
            "description": "Login of the user to add.",
            "type": "string"
          }
        },
        "required": [
          "user",
          "role"
        ],
        "type": "object"
      },
      "NewOrgBody": {
        "additionalProperties": false,
        "description": "Body of `POST /orgs`.",
        "properties": {
          "ns": {
            "description": "Slug of the organisation, which is also its namespace.",
            "type": "string"
          }
        },
        "required": [
          "ns"
        ],
        "type": "object"
      },
      "NewRelationBody": {
        "additionalProperties": false,
        "description": "Body of `POST …/relations`.",
        "properties": {
          "attrs": {
            "description": "Free-form attributes for this relation type."
          },
          "to": {
            "description": "Target: `{ns}/{name}@{seq}`, `external:…` or `hf:…`.",
            "type": "string"
          },
          "type": {
            "description": "Registry id of the relation type, `{ns}/{name}`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "to"
        ],
        "type": "object"
      },
      "NewSessionBody": {
        "additionalProperties": false,
        "description": "Body of `POST /session`.",
        "properties": {
          "token": {
            "description": "A token secret, the same string a client would send as\n`Authorization: Bearer …`.",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "NewTokenBody": {
        "additionalProperties": false,
        "description": "Body of `POST /tokens`.",
        "properties": {
          "namespaces": {
            "description": "Namespaces it covers: the caller's login, and organisations where\nthe caller is `admin`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "Scope of the new token; may not exceed the presenting token's."
          }
        },
        "required": [
          "scope",
          "namespaces"
        ],
        "type": "object"
      },
      "NodeDto": {
        "description": "A node of the relation graph.",
        "properties": {
          "content_hash": {
            "description": "sha256 of the canonical body: the commitment, always present.",
            "type": "string"
          },
          "name": {
            "description": "Record name, when the caller may see it.",
            "type": [
              "string",
              "null"
            ]
          },
          "ns": {
            "description": "Namespace, when the caller may see the record.",
            "type": [
              "string",
              "null"
            ]
          },
          "private": {
            "description": "`true` on a node the caller may not see; then only `version_id`\nand `content_hash` are present.",
            "type": "boolean"
          },
          "record_type": {
            "description": "`card` or `eval`, when the caller may see it.",
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "description": "Sequence number, when the caller may see it.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "tombstoned": {
            "description": "Whether the version has been tombstoned, when the caller may see it.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "version_id": {
            "description": "The version.",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "private",
          "content_hash"
        ],
        "type": "object"
      },
      "Page_for_AuditEntry": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_for_ListItem": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/ListItem"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_for_QueryHitDto": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/QueryHitDto"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_for_VersionEnvelope": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/VersionEnvelope"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "PostQuery": {
        "description": "Query string of `POST`.",
        "properties": {
          "label": {
            "description": "Label to attach to the new version. Never purely numeric.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "QueryFilter": {
        "description": "A filter: a connective or a leaf.",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "and": {
                "items": {
                  "$ref": "#/components/schemas/QueryFilter"
                },
                "type": "array"
              }
            },
            "required": [
              "and"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "or": {
                "items": {
                  "$ref": "#/components/schemas/QueryFilter"
                },
                "type": "array"
              }
            },
            "required": [
              "or"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "not": {
                "$ref": "#/components/schemas/QueryFilter"
              }
            },
            "required": [
              "not"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "A scalar comparison.",
            "properties": {
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "prefix",
                  "contains"
                ]
              },
              "path": {
                "type": "string"
              },
              "value": true
            },
            "required": [
              "path",
              "op",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The path has a value, `null` included.",
            "properties": {
              "op": {
                "const": "exists"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "op"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "At least one element of an array path satisfies every term.",
            "properties": {
              "match": {
                "additionalProperties": {
                  "description": "A literal (meaning `eq`), or an operator and a literal.",
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "op": {
                          "enum": [
                            "eq",
                            "ne",
                            "gt",
                            "gte",
                            "lt",
                            "lte",
                            "in",
                            "prefix",
                            "contains"
                          ]
                        },
                        "value": true
                      },
                      "required": [
                        "value"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "object"
              },
              "op": {
                "const": "any"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "op",
              "match"
            ],
            "type": "object"
          }
        ]
      },
      "QueryHitDto": {
        "description": "One matched version, with what the hub knows about it.",
        "properties": {
          "badges": {
            "description": "Badges awarded at ingest.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "changed": {
            "description": "Top-level keys whose value differs from the previous version.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "content_hash": {
            "description": "Hex sha256 of the canonical record.",
            "type": "string"
          },
          "created_at": {
            "description": "When the hub stored this version.",
            "format": "date-time",
            "type": "string"
          },
          "fingerprints": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-facet fingerprints as hex, with `expand=fingerprints`.",
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "Identifier of the named record, stable across versions (ULID).",
            "type": "string"
          },
          "label": {
            "description": "Client-chosen label of this version, if it has one.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Name of the record within the namespace.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace the record lives in.",
            "type": "string"
          },
          "record": {
            "description": "The canonical record."
          },
          "relations": {
            "description": "Outgoing edges, with `expand=relations`.",
            "items": {
              "$ref": "#/components/schemas/RelationDto"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "seq": {
            "description": "Sequence number within the name.",
            "format": "int32",
            "type": "integer"
          },
          "version_id": {
            "description": "Identifier of this version (ULID).",
            "type": "string"
          },
          "withheld": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Withheld"
              },
              {
                "type": "null"
              }
            ],
            "description": "What was removed from `record` because the caller may not see it.\nWhen present, `record` is not the stored body and does not match\n`content_hash`."
          }
        },
        "required": [
          "id",
          "version_id",
          "ns",
          "name",
          "seq",
          "content_hash",
          "created_at",
          "changed",
          "badges"
        ],
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "description": "The body of `POST /cards/query` and `POST /evals/query`.",
        "properties": {
          "cursor": {
            "description": "Opaque cursor from a previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "expand": {
            "description": "Extra fields to include on each item.",
            "items": {
              "$ref": "#/components/schemas/Expand"
            },
            "type": "array"
          },
          "limit": {
            "description": "Page size. The server clamps it to its maximum.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sort": {
            "description": "Sort keys, applied in order.",
            "items": {
              "$ref": "#/components/schemas/Sort"
            },
            "type": "array"
          },
          "version": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VersionSelector"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which versions to search. Defaults to `latest`."
          },
          "where": {
            "$ref": "#/components/schemas/QueryFilter"
          }
        },
        "type": "object"
      },
      "RecordPath": {
        "description": "Path of a record: `/{cards|evals}/{ns}/{name}`.",
        "properties": {
          "name": {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace: a user login or an organisation slug.",
            "type": "string"
          }
        },
        "required": [
          "ns",
          "name"
        ],
        "type": "object"
      },
      "RegistryListQuery": {
        "description": "Query string of `GET /registry/{kind}`.\n\nNamed for the registry rather than `ListQuery`, so that a generated\nclient gets one type per listing instead of `ListQuery` and\n`ListQuery2`.",
        "properties": {
          "limit": {
            "description": "Page size, 1–200; default 50.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ns": {
            "description": "Only entries owned by this namespace.",
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "description": "How many entries to skip.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "RelationDto": {
        "description": "An edge as returned by `POST …/relations`.",
        "properties": {
          "attrs": {
            "description": "Free-form attributes."
          },
          "from": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TargetDto"
              }
            ],
            "description": "The version the edge leaves."
          },
          "to": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TargetDto"
              }
            ],
            "description": "The version or external reference it points at."
          },
          "type": {
            "description": "Registry id of the relation type.",
            "type": "string"
          }
        },
        "required": [
          "from",
          "type",
          "to"
        ],
        "type": "object"
      },
      "RelationPath": {
        "description": "Path of the record an edge leaves or is read from:\n`/{cards|evals}/{ns}/{name}`. Named apart from the records module's\npath type so the two do not collide in the generated schema.",
        "properties": {
          "name": {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}`.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace: a user login or an organisation slug.",
            "type": "string"
          }
        },
        "required": [
          "ns",
          "name"
        ],
        "type": "object"
      },
      "ScopeDto": {
        "description": "A scope as it crosses the wire.",
        "oneOf": [
          {
            "const": "read",
            "description": "Read private records in the token's namespaces.",
            "type": "string"
          },
          {
            "const": "write",
            "description": "Also write records, relations, settings and registry entries.",
            "type": "string"
          },
          {
            "const": "admin",
            "description": "Also manage organisation members, issue organisation tokens, read audit.",
            "type": "string"
          }
        ]
      },
      "Settings": {
        "description": "Body of `PATCH …/{name}/settings` and its response.",
        "properties": {
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VisibilityParam"
              }
            ],
            "description": "`public` or `private`."
          }
        },
        "required": [
          "visibility"
        ],
        "type": "object"
      },
      "Sort": {
        "additionalProperties": false,
        "description": "One sort key.",
        "properties": {
          "dir": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Dir"
              }
            ],
            "description": "Direction."
          },
          "path": {
            "description": "A query path (for example `results[core/pass_rate].value`).",
            "type": "string"
          }
        },
        "required": [
          "path",
          "dir"
        ],
        "type": "object"
      },
      "SortParam": {
        "description": "Sort orders of the list endpoints.",
        "oneOf": [
          {
            "const": "created_desc",
            "description": "Newest record first.",
            "type": "string"
          },
          {
            "const": "created_asc",
            "description": "Oldest record first.",
            "type": "string"
          },
          {
            "const": "name_asc",
            "description": "By name, ascending.",
            "type": "string"
          }
        ]
      },
      "TargetDto": {
        "anyOf": [
          {
            "description": "A version on this hub the caller may see.",
            "properties": {
              "name": {
                "description": "Record name.",
                "type": "string"
              },
              "ns": {
                "description": "Namespace of its record.",
                "type": "string"
              },
              "record_type": {
                "description": "`card` or `eval`.",
                "type": "string"
              },
              "seq": {
                "description": "Sequence number.",
                "format": "int32",
                "type": "integer"
              },
              "tombstoned": {
                "description": "Whether the version has been tombstoned.",
                "type": "boolean"
              },
              "version_id": {
                "description": "The version.",
                "type": "string"
              }
            },
            "required": [
              "version_id",
              "ns",
              "name",
              "seq",
              "record_type",
              "tombstoned"
            ],
            "type": "object"
          },
          {
            "description": "A version the caller may not see: the commitment only.",
            "properties": {
              "content_hash": {
                "description": "sha256 of the canonical body, so the reference is still pinned.",
                "type": "string"
              },
              "private": {
                "description": "Always `true`; marks the reduced form.",
                "type": "boolean"
              },
              "version_id": {
                "description": "The version it points at.",
                "type": "string"
              }
            },
            "required": [
              "private",
              "version_id",
              "content_hash"
            ],
            "type": "object"
          },
          {
            "description": "A `{ns}/{name}@{seq}` that does not exist yet.",
            "properties": {
              "unresolved": {
                "description": "The reference as written.",
                "type": "string"
              }
            },
            "required": [
              "unresolved"
            ],
            "type": "object"
          },
          {
            "description": "An `external:` or `hf:` target.",
            "properties": {
              "external": {
                "description": "The reference as written.",
                "type": "string"
              }
            },
            "required": [
              "external"
            ],
            "type": "object"
          }
        ],
        "description": "One endpoint of an edge."
      },
      "TokenDto": {
        "description": "One of the caller's tokens. The secret is not here; it was shown once.",
        "properties": {
          "created_at": {
            "description": "When it was issued.",
            "format": "date-time",
            "type": "string"
          },
          "namespaces": {
            "description": "Namespaces it covers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "prefix": {
            "description": "First eight hex characters of the stored hash, to tell tokens apart.",
            "type": "string"
          },
          "revoked_at": {
            "description": "When it was revoked, if it was. A revoked token is refused.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "What the token may do."
          },
          "token_id": {
            "description": "Identifier of the token, used to revoke it.",
            "type": "string"
          }
        },
        "required": [
          "token_id",
          "prefix",
          "scope",
          "namespaces",
          "created_at"
        ],
        "type": "object"
      },
      "TombstoneBody": {
        "description": "Body of `DELETE …/{name}@{seq}`.",
        "properties": {
          "note": {
            "description": "Free text shown with the tombstone.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TombstoneReasonParam"
              }
            ],
            "description": "Why the version is withdrawn."
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "TombstoneDto": {
        "description": "The tombstone of a withdrawn version.",
        "properties": {
          "at": {
            "description": "When it was withdrawn.",
            "format": "date-time",
            "type": "string"
          },
          "note": {
            "description": "Free text from the producer, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TombstoneReasonParam"
              }
            ],
            "description": "Why."
          }
        },
        "required": [
          "at",
          "reason"
        ],
        "type": "object"
      },
      "TombstoneReasonParam": {
        "description": "Why a version was tombstoned.",
        "oneOf": [
          {
            "const": "withdrawn",
            "description": "The producer withdrew it.",
            "type": "string"
          },
          {
            "const": "duplicate",
            "description": "It duplicated another version.",
            "type": "string"
          },
          {
            "const": "takedown",
            "description": "Removed following a takedown request.",
            "type": "string"
          },
          {
            "const": "other",
            "description": "See the note.",
            "type": "string"
          }
        ]
      },
      "TraverseQuery": {
        "description": "Query string of `GET …/relations`.",
        "properties": {
          "depth": {
            "description": "How many edges from the start, 1–5; default 1.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "direction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DirectionParam"
              },
              {
                "type": "null"
              }
            ],
            "description": "`out` (default), `in` or `both`."
          },
          "follow_latest": {
            "description": "Walk from the latest live version of each record instead of the\nversion the edge names.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "types": {
            "description": "Comma-separated relation type ids to follow; all by default.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "VersionEnvelope": {
        "description": "What the hub adds around a stored version.",
        "properties": {
          "badges": {
            "description": "Badges awarded at ingest.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "changed": {
            "description": "Top-level keys whose value differs from the previous version.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "content_hash": {
            "description": "Hex sha256 of the canonical record.",
            "type": "string"
          },
          "created_at": {
            "description": "When the hub stored this version.",
            "format": "date-time",
            "type": "string"
          },
          "fingerprints": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-facet fingerprints as hex, with `expand=fingerprints`.",
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "Identifier of the named record, stable across versions (ULID).",
            "type": "string"
          },
          "label": {
            "description": "Client-chosen label of this version, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "record": {
            "description": "The canonical record. Absent in `POST` responses, in version lists,\nand for tombstones."
          },
          "relations": {
            "description": "The version's outgoing edges, with `expand=relations`.",
            "items": {
              "$ref": "#/components/schemas/RelationDto"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "seq": {
            "description": "Sequence number within the name, from 1, gap-free.",
            "format": "int32",
            "type": "integer"
          },
          "tombstone": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TombstoneDto"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present when the version was withdrawn; `record` is then absent."
          },
          "version_id": {
            "description": "Identifier of this version (ULID). Relations point at these.",
            "type": "string"
          },
          "withheld": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Withheld"
              },
              {
                "type": "null"
              }
            ],
            "description": "What was removed from `record` because the caller may not see it.\nWhen present, `record` is not the stored body and does not match\n`content_hash`."
          }
        },
        "required": [
          "id",
          "version_id",
          "seq",
          "content_hash",
          "created_at",
          "changed",
          "badges"
        ],
        "type": "object"
      },
      "VersionSelector": {
        "description": "Which versions a query considers.",
        "oneOf": [
          {
            "const": "latest",
            "description": "Only the latest non-tombstoned version of each name.",
            "type": "string"
          },
          {
            "const": "all",
            "description": "Every non-tombstoned version.",
            "type": "string"
          }
        ]
      },
      "VisibilityParam": {
        "description": "A record's visibility.",
        "oneOf": [
          {
            "const": "public",
            "description": "Readable by anyone.",
            "type": "string"
          },
          {
            "const": "private",
            "description": "Readable only with a token covering the namespace.",
            "type": "string"
          }
        ]
      },
      "Whoami": {
        "description": "`GET /api/v1/whoami`",
        "properties": {
          "namespaces": {
            "description": "Namespaces the presented token covers. Empty when anonymous.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "description": "Scope of the presented token, or `null` when anonymous.",
            "type": [
              "string",
              "null"
            ]
          },
          "user": {
            "description": "Login of the authenticated user, or `null` for an anonymous caller.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "namespaces"
        ],
        "type": "object"
      },
      "Withheld": {
        "description": "What a read removed from a record body because the reader may not see\nit. Present in an envelope only when something was removed.",
        "properties": {
          "relations": {
            "description": "One entry per removed `relations[]` element, in body order.",
            "items": {
              "$ref": "#/components/schemas/WithheldRelation"
            },
            "type": "array"
          }
        },
        "required": [
          "relations"
        ],
        "type": "object"
      },
      "WithheldRelation": {
        "description": "A removed `relations[]` element, reduced to the commitment: the same\n`version_id` and `content_hash` a `private` endpoint of\n`GET …/relations` shows.",
        "properties": {
          "content_hash": {
            "description": "sha256 of that version's canonical body.",
            "type": "string"
          },
          "type": {
            "description": "Registry id of the relation type of the element.",
            "type": "string"
          },
          "version_id": {
            "description": "The version it points at.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "version_id",
          "content_hash"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A hosting service for named, versioned LLM evaluation results (Cards) and their materials (Evals). The hub validates, indexes and compares; it does not run evaluations.",
    "title": "evalhub",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/attachments": {
      "post": {
        "description": "Returns `200 { state: \"ready\" }` when the object is already confirmed, otherwise `201` with a presigned `PUT` URL. The hub never receives the bytes: they go straight to the object store. Any valid token may announce; using the object needs `write` on the record's namespace.",
        "operationId": "announce_attachment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnnounceBody"
              }
            }
          },
          "description": "Body of `POST /attachments`.",
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to parse the request body as JSON"
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "415": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Expected request with `Content-Type: application/json`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Announce an upload"
      }
    },
    "/api/v1/attachments/{sha256}": {
      "get": {
        "description": "`302` to a presigned, time-limited URL. Open to everyone when a public record references the object, to the covering token when only private ones do, and to any token while the object is not referenced at all.",
        "operationId": "download_attachment",
        "responses": {
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Download an attachment"
      },
      "head": {
        "description": "The same authorisation as the download, without the redirect.",
        "operationId": "head_attachment",
        "responses": {
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Size and media type of an attachment"
      }
    },
    "/api/v1/attachments/{sha256}/complete": {
      "post": {
        "description": "Checks the object exists with the announced size and, below `attachments.hash_verify_max_bytes`, that its bytes hash to the announced sha256. A mismatch is `422` and the object stays pending.",
        "operationId": "complete_attachment",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedDto"
                }
              }
            },
            "description": "Response of `POST /attachments/{sha256}/complete`."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Confirm an upload"
      }
    },
    "/api/v1/audit": {
      "get": {
        "description": "Append-only: who changed what, when. Newest first, paged by cursor. Requires `admin` on the namespace.",
        "operationId": "list_audit",
        "parameters": [
          {
            "description": "Cursor from a previous page's `next_cursor`.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Cursor from a previous page's `next_cursor`.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Page size, 1–200; default 50.",
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Page size, 1–200; default 50.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "style": "form"
          },
          {
            "description": "Namespace to read the log of. The caller needs `admin` on it.",
            "in": "query",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace to read the log of. The caller needs `admin` on it.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_for_AuditEntry"
                }
              }
            },
            "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Audit log of a namespace"
      }
    },
    "/api/v1/cards": {
      "get": {
        "description": "Names with at least one live version, newest first by default. Private records appear only for a caller whose token covers their namespace. Paging is by opaque cursor.",
        "operationId": "list_cards",
        "parameters": [
          {
            "description": "Cursor from a previous page's `next_cursor`.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Cursor from a previous page's `next_cursor`.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Page size, 1–200; default 50.",
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Page size, 1–200; default 50.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "style": "form"
          },
          {
            "description": "Only records in this namespace.",
            "in": "query",
            "name": "ns",
            "schema": {
              "description": "Only records in this namespace.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Case-insensitive substring of the name or the latest title.",
            "in": "query",
            "name": "search",
            "schema": {
              "description": "Case-insensitive substring of the name or the latest title.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Sort order; default `created_desc`.",
            "in": "query",
            "name": "sort",
            "schema": {
              "$ref": "#/components/schemas/SortParam",
              "description": "Sort order; default `created_desc`."
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_for_ListItem"
                }
              }
            },
            "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "List cards"
      }
    },
    "/api/v1/cards/query": {
      "post": {
        "description": "A typed filter over the record schema. Every path is checked against the schema and against what the indexes can serve, so a typo is `422 unknown_path` rather than an empty page, and an operator no index answers is `422 not_indexed` rather than a sequential scan. Paging is by opaque cursor; `expand` adds fingerprints or relations to each hit.",
        "operationId": "query_cards",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "description": "The body of `POST /cards/query` and `POST /evals/query`.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_for_QueryHitDto"
                }
              }
            },
            "description": "One page of matching versions."
          },
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to parse the request body as JSON"
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "415": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Expected request with `Content-Type: application/json`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Search Cards"
      }
    },
    "/api/v1/cards/{ns}/{name}": {
      "delete": {
        "description": "Addresses one version with `@{seq}` and replaces its body with a tombstone carrying a reason. The version id, the content hash and `changed[]` remain, so relations pointing at it still resolve and show what happened.",
        "operationId": "delete_card",
        "parameters": [
          {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Namespace: a user login or an organisation slug.",
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace: a user login or an organisation slug.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TombstoneBody"
              }
            }
          },
          "description": "Body of `DELETE …/{name}@{seq}`.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            },
            "description": "What the hub adds around a stored version."
          },
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to parse the request body as JSON"
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "415": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Expected request with `Content-Type: application/json`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Tombstone Card version"
      },
      "get": {
        "description": "The latest live version of `{ns}/{name}`, or the version `@{seq}`. Private records are `404` to a caller whose token does not cover `ns`.",
        "operationId": "get_card",
        "parameters": [
          {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Namespace: a user login or an organisation slug.",
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace: a user login or an organisation slug.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Comma-separated: `fingerprints`, `badges`, `changed`, `relations`.",
            "in": "query",
            "name": "expand",
            "schema": {
              "description": "Comma-separated: `fingerprints`, `badges`, `changed`, `relations`.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            },
            "description": "The version and the hub's facts about it."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Read Card version"
      },
      "post": {
        "description": "Validates the body, canonicalises it and stores it as the next version of `{ns}/{name}`, creating the name if needed. Requires a token with `write` on `ns`. If the canonical body equals the latest version's, that version is returned with `200` and nothing is written.",
        "operationId": "post_card",
        "parameters": [
          {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Namespace: a user login or an organisation slug.",
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace: a user login or an organisation slug.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Label to attach to the new version. Never purely numeric.",
            "in": "query",
            "name": "label",
            "schema": {
              "description": "Label to attach to the new version. Never purely numeric.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": true
            }
          },
          "required": true
        },
        "responses": {
          "200": {
