---
source: crates/evalhub-server/tests/boot.rs
expression: body
---
{
  "components": {
    "schemas": {
      "AnnounceBody": {
        "additionalProperties": false,
        "description": "Body of `POST /attachments`.",
        "properties": {
          "media_type": {
            "description": "Media type hint, for display and download. Not interpreted.",
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "description": "sha256 of the bytes, 64 lower-case hexadecimal characters. This is\nthe object's only name.",
            "type": "string"
          },
          "size": {
            "description": "Size of the bytes. `complete` refuses an object of another size.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "type": "object"
      },
      "AuditEntry": {
        "description": "One entry of the log.",
        "properties": {
          "action": {
            "description": "What happened, such as `version.append` or `org.member.add`.",
            "type": "string"
          },
          "actor": {
            "description": "Login of the user behind the action, if there was one.",
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "description": "When it happened.",
            "format": "date-time",
            "type": "string"
          },
          "detail": {
            "description": "Action-specific facts."
          },
          "ns": {
            "description": "The namespace the action concerns.",
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "description": "What it happened to, such as `card/alice/single2@3`.",
            "type": [
              "string",
              "null"
            ]
          },
          "token_id": {
            "description": "Identifier of the token presented, if one was.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "at",
          "action"
        ],
        "type": "object"
      },
      "AuditQuery": {
        "description": "Query string of `GET /audit`.",
        "properties": {
          "cursor": {
            "description": "Cursor from a previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "description": "Page size, 1–200; default 50.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ns": {
            "description": "Namespace to read the log of. The caller needs `admin` on it.",
            "type": "string"
          }
        },
        "required": [
          "ns"
        ],
        "type": "object"
      },
      "ComparisonDto": {
        "description": "The comparison view: Cards measured on one Eval version.",
        "properties": {
          "groups": {
            "description": "The Cards grouped by the requested facet fingerprint.",
            "items": {
              "$ref": "#/components/schemas/ComparisonGroupDto"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "items": {
            "description": "Every Card, when `group_by` was not given.",
            "items": {
              "$ref": "#/components/schemas/ComparisonRowDto"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ComparisonGroupDto": {
        "description": "Cards sharing one fingerprint of the facet named in `group_by`.",
        "properties": {
          "items": {
            "description": "The Cards in the group.",
            "items": {
              "$ref": "#/components/schemas/ComparisonRowDto"
            },
            "type": "array"
          },
          "key": {
            "description": "The shared fingerprint in hex, or `null` for Cards with none.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ComparisonQuery": {
        "description": "Query string of the comparison view.",
        "properties": {
          "group_by": {
            "description": "`fingerprint.{facet}` for one of the seven facets. Groups the\nCards by that fingerprint; omitted, the list is flat.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ComparisonRowDto": {
        "description": "One Card in the comparison view.",
        "properties": {
          "content_hash": {
            "description": "sha256 of the canonical body.",
            "type": "string"
          },
          "fingerprints": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-facet fingerprints, hex, keyed by facet name.",
            "type": "object"
          },
          "name": {
            "description": "Record name.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace.",
            "type": "string"
          },
          "same_harness": {
            "description": "The Card's harness fingerprint equals the Eval's.",
            "type": "boolean"
          },
          "same_model": {
            "description": "The Card's model fingerprint equals the Eval's.",
            "type": "boolean"
          },
          "seq": {
            "description": "Sequence number of that version.",
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "description": "The record's title.",
            "type": [
              "string",
              "null"
            ]
          },
          "version_id": {
            "description": "The Card's latest live version.",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "ns",
          "name",
          "seq",
          "content_hash",
          "fingerprints",
          "same_harness",
          "same_model"
        ],
        "type": "object"
      },
      "CompletedDto": {
        "description": "Response of `POST /attachments/{sha256}/complete`.",
        "properties": {
          "hashed_by_hub": {
            "description": "Whether the hub re-hashed the bytes. `false` means the object was\nabove `attachments.hash_verify_max_bytes` and the client's sha256\nwas taken on trust; the record says which.",
            "type": "boolean"
          },
          "size": {
            "description": "Size of the object as the store reports it.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "size",
          "hashed_by_hub"
        ],
        "type": "object"
      },
      "DirectionParam": {
        "description": "Which edges a traversal follows.",
        "oneOf": [
          {
            "const": "out",
            "description": "Edges leaving the node.",
            "type": "string"
          },
          {
            "const": "in",
            "description": "Edges entering the node.",
            "type": "string"
          },
          {
            "const": "both",
            "description": "Both.",
            "type": "string"
          }
        ]
      },
      "EdgeDto": {
        "description": "An edge of the relation graph.",
        "properties": {
          "attrs": {
            "description": "Free-form attributes."
          },
          "from": {
            "description": "Version the edge leaves.",
            "type": "string"
          },
          "to": {
            "description": "Version it points at, when the target is on this hub.",
            "type": [
              "string",
              "null"
            ]
          },
          "to_text": {
            "description": "Textual target, for an unresolved or external reference.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "Registry id of the relation type.",
            "type": "string"
          }
        },
        "required": [
          "from",
          "type"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The closed set of error codes.",
        "oneOf": [
          {
            "const": "schema",
            "description": "JSON Schema violation: unknown key, wrong type, missing required key.",
            "type": "string"
          },
          {
            "const": "number_too_large",
            "description": "An integer outside ±2^53.",
            "type": "string"
          },
          {
            "const": "counts_missing",
            "description": "`results` is non-empty but `counts` is absent.",
            "type": "string"
          },
          {
            "const": "counts_inconsistent",
            "description": "`counts.attempted < completed + failed + skipped + errored`.",
            "type": "string"
          },
          {
            "const": "attachment_ref_unknown",
            "description": "A `samples_ref`, `calls` or `artifacts[]` entry names no `attachments[].path`.",
            "type": "string"
          },
          {
            "const": "attachment_path_invalid",
            "description": "An `attachments[].path` is duplicated, absolute, or contains `..`.",
            "type": "string"
          },
          {
            "const": "metric_id_invalid",
            "description": "A `results[].metric` is not of the form `{ns}/{name}`.",
            "type": "string"
          },
          {
            "const": "type_mismatch",
            "description": "Query: operator applied to a path of another type.",
            "type": "string"
          },
          {
            "const": "not_indexed",
            "description": "Query: operator needs an index the path does not have.",
            "type": "string"
          },
          {
            "const": "unknown_path",
            "description": "Query: path not in the schema.",
            "type": "string"
          },
          {
            "const": "attachment_missing",
            "description": "An `attachments[].sha256` has not been uploaded and confirmed.",
            "type": "string"
          },
          {
            "const": "label_in_use",
            "description": "The requested `@{label}` already names another version.",
            "type": "string"
          },
          {
            "const": "namespace_in_use",
            "description": "The requested organisation slug is already a user or an organisation.",
            "type": "string"
          }
        ]
      },
      "ErrorEntry": {
        "additionalProperties": false,
        "description": "One rejection.",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ],
            "description": "The code."
          },
          "hint": {
            "description": "Prose for a human. Not part of the contract.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Location in the submitted document, JSON-pointer-like (`results[0].metric`).",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "description": "The body of every `422` and `409` response.",
        "properties": {
          "errors": {
            "description": "Every rejection found, in document order.",
            "items": {
              "$ref": "#/components/schemas/ErrorEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "GetQuery": {
        "description": "Query string of `GET …/{name}`.",
        "properties": {
          "expand": {
            "description": "Comma-separated: `fingerprints`, `badges`, `changed`, `relations`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "GraphDto": {
        "description": "What a traversal found.",
        "properties": {
          "edges": {
            "description": "Every edge followed.",
            "items": {
              "$ref": "#/components/schemas/EdgeDto"
            },
            "type": "array"
          },
          "nodes": {
            "description": "Every version reached, the start first.",
            "items": {
              "$ref": "#/components/schemas/NodeDto"
            },
            "type": "array"
          }
        },
        "required": [
          "nodes",
          "edges"
        ],
        "type": "object"
      },
      "Health": {
        "description": "`GET /api/v1/healthz`",
        "properties": {
          "database": {
            "description": "`connected` when a database pool is open, `not_configured` otherwise.",
            "type": "string"
          },
          "status": {
            "description": "Always `ok` when the process answers.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "type": "object"
      },
      "Items_for_MemberDto": {
        "description": "A list of things, without paging: these are all small.\n\nThe schema name carries the item type, so a generated client gets one\nlist type per item type instead of `Items` and `Items2`.",
        "properties": {
          "items": {
            "description": "The items.",
            "items": {
              "$ref": "#/components/schemas/MemberDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Items_for_TokenDto": {
        "description": "A list of things, without paging: these are all small.\n\nThe schema name carries the item type, so a generated client gets one\nlist type per item type instead of `Items` and `Items2`.",
        "properties": {
          "items": {
            "description": "The items.",
            "items": {
              "$ref": "#/components/schemas/TokenDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "LabelBody": {
        "description": "Body of `PATCH …/{name}@{seq}/label`.",
        "properties": {
          "label": {
            "description": "The label to point at this version. Moved if it named another.",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "ListItem": {
        "description": "One row of `GET /{cards|evals}`.",
        "properties": {
          "created_at": {
            "description": "When the name was created.",
            "format": "date-time",
            "type": "string"
          },
          "latest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VersionEnvelope"
              }
            ],
            "description": "The latest live version, without its record."
          },
          "name": {
            "description": "Name of the record.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace of the record.",
            "type": "string"
          },
          "title": {
            "description": "`title` of the latest live version.",
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VisibilityParam"
              }
            ],
            "description": "`public` or `private`."
          }
        },
        "required": [
          "ns",
          "name",
          "visibility",
          "created_at",
          "latest"
        ],
        "type": "object"
      },
      "ListQuery": {
        "description": "Query string of `GET /{cards|evals}`.",
        "properties": {
          "cursor": {
            "description": "Cursor from a previous page's `next_cursor`.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "description": "Page size, 1–200; default 50.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "ns": {
            "description": "Only records in this namespace.",
            "type": [
              "string",
              "null"
            ]
          },
          "search": {
            "description": "Case-insensitive substring of the name or the latest title.",
            "type": [
              "string",
              "null"
            ]
          },
          "sort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SortParam"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sort order; default `created_desc`."
          }
        },
        "type": "object"
      },
      "MemberDto": {
        "description": "A member of an organisation.",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "Their role in the organisation."
          },
          "user": {
            "description": "The member's login.",
            "type": "string"
          }
        },
        "required": [
          "user",
          "role"
        ],
        "type": "object"
      },
      "NamespaceDto": {
        "description": "A namespace and what it holds.",
        "properties": {
          "cards": {
            "description": "Cards in it that the caller may see.",
            "format": "int64",
            "type": "integer"
          },
          "created_at": {
            "description": "When it was created.",
            "format": "date-time",
            "type": "string"
          },
          "evals": {
            "description": "Evals in it that the caller may see.",
            "format": "int64",
            "type": "integer"
          },
          "kind": {
            "description": "`user` or `org`.",
            "type": "string"
          },
          "ns": {
            "description": "The namespace: a user login or an organisation slug.",
            "type": "string"
          }
        },
        "required": [
          "ns",
          "kind",
          "created_at",
          "cards",
          "evals"
        ],
        "type": "object"
      },
      "NewMemberBody": {
        "additionalProperties": false,
        "description": "Body of `POST /orgs/{org}/members`.",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "The role they get."
          },
          "user": {
            "description": "Login of the user to add.",
            "type": "string"
          }
        },
        "required": [
          "user",
          "role"
        ],
        "type": "object"
      },
      "NewOrgBody": {
        "additionalProperties": false,
        "description": "Body of `POST /orgs`.",
        "properties": {
          "ns": {
            "description": "Slug of the organisation, which is also its namespace.",
            "type": "string"
          }
        },
        "required": [
          "ns"
        ],
        "type": "object"
      },
      "NewRelationBody": {
        "additionalProperties": false,
        "description": "Body of `POST …/relations`.",
        "properties": {
          "attrs": {
            "description": "Free-form attributes for this relation type."
          },
          "to": {
            "description": "Target: `{ns}/{name}@{seq}`, `external:…` or `hf:…`.",
            "type": "string"
          },
          "type": {
            "description": "Registry id of the relation type, `{ns}/{name}`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "to"
        ],
        "type": "object"
      },
      "NewTokenBody": {
        "additionalProperties": false,
        "description": "Body of `POST /tokens`.",
        "properties": {
          "namespaces": {
            "description": "Namespaces it covers: the caller's login, and organisations where\nthe caller is `admin`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "Scope of the new token; may not exceed the presenting token's."
          }
        },
        "required": [
          "scope",
          "namespaces"
        ],
        "type": "object"
      },
      "NodeDto": {
        "description": "A node of the relation graph.",
        "properties": {
          "content_hash": {
            "description": "sha256 of the canonical body: the commitment, always present.",
            "type": "string"
          },
          "name": {
            "description": "Record name, when the caller may see it.",
            "type": [
              "string",
              "null"
            ]
          },
          "ns": {
            "description": "Namespace, when the caller may see the record.",
            "type": [
              "string",
              "null"
            ]
          },
          "private": {
            "description": "`true` on a node the caller may not see; then only `version_id`\nand `content_hash` are present.",
            "type": "boolean"
          },
          "record_type": {
            "description": "`card` or `eval`, when the caller may see it.",
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "description": "Sequence number, when the caller may see it.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "tombstoned": {
            "description": "Whether the version has been tombstoned, when the caller may see it.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "version_id": {
            "description": "The version.",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "private",
          "content_hash"
        ],
        "type": "object"
      },
      "Page_for_AuditEntry": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_for_ListItem": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/ListItem"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_for_VersionEnvelope": {
        "additionalProperties": false,
        "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/VersionEnvelope"
            },
            "type": "array"
          },
          "next_cursor": {
            "default": null,
            "description": "Cursor for the next page, or `null` on the last page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "PostQuery": {
        "description": "Query string of `POST`.",
        "properties": {
          "label": {
            "description": "Label to attach to the new version. Never purely numeric.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "RecordPath": {
        "description": "Path of a record: `/{cards|evals}/{ns}/{name}`.",
        "properties": {
          "name": {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace: a user login or an organisation slug.",
            "type": "string"
          }
        },
        "required": [
          "ns",
          "name"
        ],
        "type": "object"
      },
      "RelationPath": {
        "description": "Path of the record an edge leaves or is read from:\n`/{cards|evals}/{ns}/{name}`. Named apart from the records module's\npath type so the two do not collide in the generated schema.",
        "properties": {
          "name": {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}`.",
            "type": "string"
          },
          "ns": {
            "description": "Namespace: a user login or an organisation slug.",
            "type": "string"
          }
        },
        "required": [
          "ns",
          "name"
        ],
        "type": "object"
      },
      "ScopeDto": {
        "description": "A scope as it crosses the wire.",
        "oneOf": [
          {
            "const": "read",
            "description": "Read private records in the token's namespaces.",
            "type": "string"
          },
          {
            "const": "write",
            "description": "Also write records, relations, settings and registry entries.",
            "type": "string"
          },
          {
            "const": "admin",
            "description": "Also manage organisation members, issue organisation tokens, read audit.",
            "type": "string"
          }
        ]
      },
      "Settings": {
        "description": "Body of `PATCH …/{name}/settings` and its response.",
        "properties": {
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VisibilityParam"
              }
            ],
            "description": "`public` or `private`."
          }
        },
        "required": [
          "visibility"
        ],
        "type": "object"
      },
      "SortParam": {
        "description": "Sort orders of the list endpoints.",
        "oneOf": [
          {
            "const": "created_desc",
            "description": "Newest record first.",
            "type": "string"
          },
          {
            "const": "created_asc",
            "description": "Oldest record first.",
            "type": "string"
          },
          {
            "const": "name_asc",
            "description": "By name, ascending.",
            "type": "string"
          }
        ]
      },
      "TokenDto": {
        "description": "One of the caller's tokens. The secret is not here; it was shown once.",
        "properties": {
          "created_at": {
            "description": "When it was issued.",
            "format": "date-time",
            "type": "string"
          },
          "namespaces": {
            "description": "Namespaces it covers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "prefix": {
            "description": "First eight hex characters of the stored hash, to tell tokens apart.",
            "type": "string"
          },
          "revoked_at": {
            "description": "When it was revoked, if it was. A revoked token is refused.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ScopeDto"
              }
            ],
            "description": "What the token may do."
          },
          "token_id": {
            "description": "Identifier of the token, used to revoke it.",
            "type": "string"
          }
        },
        "required": [
          "token_id",
          "prefix",
          "scope",
          "namespaces",
          "created_at"
        ],
        "type": "object"
      },
      "TombstoneBody": {
        "description": "Body of `DELETE …/{name}@{seq}`.",
        "properties": {
          "note": {
            "description": "Free text shown with the tombstone.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TombstoneReasonParam"
              }
            ],
            "description": "Why the version is withdrawn."
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "TombstoneDto": {
        "description": "The tombstone of a withdrawn version.",
        "properties": {
          "at": {
            "description": "When it was withdrawn.",
            "format": "date-time",
            "type": "string"
          },
          "note": {
            "description": "Free text from the producer, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TombstoneReasonParam"
              }
            ],
            "description": "Why."
          }
        },
        "required": [
          "at",
          "reason"
        ],
        "type": "object"
      },
      "TombstoneReasonParam": {
        "description": "Why a version was tombstoned.",
        "oneOf": [
          {
            "const": "withdrawn",
            "description": "The producer withdrew it.",
            "type": "string"
          },
          {
            "const": "duplicate",
            "description": "It duplicated another version.",
            "type": "string"
          },
          {
            "const": "takedown",
            "description": "Removed following a takedown request.",
            "type": "string"
          },
          {
            "const": "other",
            "description": "See the note.",
            "type": "string"
          }
        ]
      },
      "TraverseQuery": {
        "description": "Query string of `GET …/relations`.",
        "properties": {
          "depth": {
            "description": "How many edges from the start, 1–5; default 1.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "direction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DirectionParam"
              },
              {
                "type": "null"
              }
            ],
            "description": "`out` (default), `in` or `both`."
          },
          "follow_latest": {
            "description": "Walk from the latest live version of each record instead of the\nversion the edge names.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "types": {
            "description": "Comma-separated relation type ids to follow; all by default.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "VersionEnvelope": {
        "description": "What the hub adds around a stored version.",
        "properties": {
          "badges": {
            "description": "Badges awarded at ingest.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "changed": {
            "description": "Top-level keys whose value differs from the previous version.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "content_hash": {
            "description": "Hex sha256 of the canonical record.",
            "type": "string"
          },
          "created_at": {
            "description": "When the hub stored this version.",
            "format": "date-time",
            "type": "string"
          },
          "fingerprints": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per-facet fingerprints as hex, with `expand=fingerprints`.",
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "Identifier of the named record, stable across versions (ULID).",
            "type": "string"
          },
          "label": {
            "description": "Client-chosen label of this version, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "record": {
            "description": "The canonical record. Absent in `POST` responses, in version lists,\nand for tombstones."
          },
          "seq": {
            "description": "Sequence number within the name, from 1, gap-free.",
            "format": "int32",
            "type": "integer"
          },
          "tombstone": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TombstoneDto"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present when the version was withdrawn; `record` is then absent."
          },
          "version_id": {
            "description": "Identifier of this version (ULID). Relations point at these.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version_id",
          "seq",
          "content_hash",
          "created_at",
          "changed",
          "badges"
        ],
        "type": "object"
      },
      "VisibilityParam": {
        "description": "A record's visibility.",
        "oneOf": [
          {
            "const": "public",
            "description": "Readable by anyone.",
            "type": "string"
          },
          {
            "const": "private",
            "description": "Readable only with a token covering the namespace.",
            "type": "string"
          }
        ]
      },
      "Whoami": {
        "description": "`GET /api/v1/whoami`",
        "properties": {
          "namespaces": {
            "description": "Namespaces the presented token covers. Empty when anonymous.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "description": "Scope of the presented token, or `null` when anonymous.",
            "type": [
              "string",
              "null"
            ]
          },
          "user": {
            "description": "Login of the authenticated user, or `null` for an anonymous caller.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "namespaces"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A hosting service for named, versioned LLM evaluation results (Cards) and their materials (Evals). The hub validates, indexes and compares; it does not run evaluations.",
    "title": "evalhub",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/attachments": {
      "post": {
        "description": "Returns `200 { state: \"ready\" }` when the object is already confirmed, otherwise `201` with a presigned `PUT` URL. The hub never receives the bytes: they go straight to the object store. Any valid token may announce; using the object needs `write` on the record's namespace.",
        "operationId": "announce_attachment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnnounceBody"
              }
            }
          },
          "description": "Body of `POST /attachments`.",
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to parse the request body as JSON"
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "415": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Expected request with `Content-Type: application/json`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Announce an upload"
      }
    },
    "/api/v1/attachments/{sha256}": {
      "get": {
        "description": "`302` to a presigned, time-limited URL. Open to everyone when a public record references the object, to the covering token when only private ones do, and to any token while the object is not referenced at all.",
        "operationId": "download_attachment",
        "responses": {
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Download an attachment"
      },
      "head": {
        "description": "The same authorisation as the download, without the redirect.",
        "operationId": "head_attachment",
        "responses": {
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Size and media type of an attachment"
      }
    },
    "/api/v1/attachments/{sha256}/complete": {
      "post": {
        "description": "Checks the object exists with the announced size and, below `attachments.hash_verify_max_bytes`, that its bytes hash to the announced sha256. A mismatch is `422` and the object stays pending.",
        "operationId": "complete_attachment",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedDto"
                }
              }
            },
            "description": "Response of `POST /attachments/{sha256}/complete`."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Confirm an upload"
      }
    },
    "/api/v1/audit": {
      "get": {
        "description": "Append-only: who changed what, when. Newest first, paged by cursor. Requires `admin` on the namespace.",
        "operationId": "list_audit",
        "parameters": [
          {
            "description": "Cursor from a previous page's `next_cursor`.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Cursor from a previous page's `next_cursor`.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Page size, 1–200; default 50.",
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Page size, 1–200; default 50.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "style": "form"
          },
          {
            "description": "Namespace to read the log of. The caller needs `admin` on it.",
            "in": "query",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace to read the log of. The caller needs `admin` on it.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_for_AuditEntry"
                }
              }
            },
            "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Audit log of a namespace"
      }
    },
    "/api/v1/cards": {
      "get": {
        "description": "Names with at least one live version, newest first by default. Private records appear only for a caller whose token covers their namespace. Paging is by opaque cursor.",
        "operationId": "list_cards",
        "parameters": [
          {
            "description": "Cursor from a previous page's `next_cursor`.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Cursor from a previous page's `next_cursor`.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Page size, 1–200; default 50.",
            "in": "query",
            "name": "limit",
            "schema": {
              "description": "Page size, 1–200; default 50.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "style": "form"
          },
          {
            "description": "Only records in this namespace.",
            "in": "query",
            "name": "ns",
            "schema": {
              "description": "Only records in this namespace.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Case-insensitive substring of the name or the latest title.",
            "in": "query",
            "name": "search",
            "schema": {
              "description": "Case-insensitive substring of the name or the latest title.",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "Sort order; default `created_desc`.",
            "in": "query",
            "name": "sort",
            "schema": {
              "$ref": "#/components/schemas/SortParam",
              "description": "Sort order; default `created_desc`."
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_for_ListItem"
                }
              }
            },
            "description": "One page of results.\n\nThe schema name carries the item type (`Page_for_VersionEnvelope`), so a\ngenerated client gets one page type per item type instead of `Page` and\n`Page2`."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "List cards"
      }
    },
    "/api/v1/cards/{ns}/{name}": {
      "delete": {
        "description": "Addresses one version with `@{seq}` and replaces its body with a tombstone carrying a reason. The version id, the content hash and `changed[]` remain, so relations pointing at it still resolve and show what happened.",
        "operationId": "delete_card",
        "parameters": [
          {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Namespace: a user login or an organisation slug.",
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace: a user login or an organisation slug.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TombstoneBody"
              }
            }
          },
          "description": "Body of `DELETE …/{name}@{seq}`.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            },
            "description": "What the hub adds around a stored version."
          },
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to parse the request body as JSON"
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "415": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Expected request with `Content-Type: application/json`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Tombstone Card version"
      },
      "get": {
        "description": "The latest live version of `{ns}/{name}`, or the version `@{seq}`. Private records are `404` to a caller whose token does not cover `ns`.",
        "operationId": "get_card",
        "parameters": [
          {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Namespace: a user login or an organisation slug.",
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace: a user login or an organisation slug.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Comma-separated: `fingerprints`, `badges`, `changed`, `relations`.",
            "in": "query",
            "name": "expand",
            "schema": {
              "description": "Comma-separated: `fingerprints`, `badges`, `changed`, `relations`.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            },
            "description": "The version and the hub's facts about it."
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Read Card version"
      },
      "post": {
        "description": "Validates the body, canonicalises it and stores it as the next version of `{ns}/{name}`, creating the name if needed. Requires a token with `write` on `ns`. If the canonical body equals the latest version's, that version is returned with `200` and nothing is written.",
        "operationId": "post_card",
        "parameters": [
          {
            "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Record name, optionally followed by `@{seq}` or `@{label}` to\naddress one version.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Namespace: a user login or an organisation slug.",
            "in": "path",
            "name": "ns",
            "required": true,
            "schema": {
              "description": "Namespace: a user login or an organisation slug.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "Label to attach to the new version. Never purely numeric.",
            "in": "query",
            "name": "label",
            "schema": {
              "description": "Label to attach to the new version. Never purely numeric.",
              "type": "string"
            },
            "style": "form"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": true
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            },
            "description": "The body equals the latest version; that version is returned."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionEnvelope"
                }
              }
            },
            "description": "A new version was stored."
          },
          "400": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to parse the request body as JSON"
          },
          "401": {
            "description": "No token, or an unrecognised one."
          },
          "403": {
            "description": "The token lacks the scope or namespace."
          },
          "404": {
            "description": "Not found, or private to a namespace the caller cannot see."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "State conflict: an attachment is not ready, or the label is taken."
          },
          "415": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Expected request with `Content-Type: application/json`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record is invalid; every violation is listed."
          }
        },
        "summary": "Append Card version"
      }
    },
