              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "`fingerprint.{facet}` for one of the seven facets. Groups the\nCards by that fingerprint; omitted, the list is flat.",
            "in": "query",
            "name": "group_by",
            "schema": {
              "description": "`fingerprint.{facet}` for one of the seven facets. Groups the\nCards by that fingerprint; omitted, the list is flat.",
              "type": "string"
