  "query": "SELECT r.ns, r.visibility, v.version_id\n         FROM attachment_refs ar\n         JOIN versions v ON v.version_id = ar.version_id\n         JOIN records r ON r.id = v.record_id\n         WHERE ar.sha256 = $1\n         ORDER BY v.created_at",
